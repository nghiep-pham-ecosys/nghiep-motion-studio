{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nghiep-motion-studio:scenes:1",
  "title": "scenes.json",
  "description": "One video as a list of scenes. One file serves every language: narration and on-screen text are keyed by language code, visuals are shared.",
  "type": "object",
  "required": ["version", "title", "languages", "scenes"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "title": {"$ref": "#/$defs/localized"},
    "languages": {
      "description": "Languages this video is made in. Every localized field must cover each of them.",
      "type": "array",
      "items": {"$ref": "#/$defs/lang"},
      "minItems": 1,
      "uniqueItems": true
    },
    "output": {
      "description": "Output format. Defaults: 1920x1080 at 30 fps.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 16, "maximum": 7680, "multipleOf": 2},
        "height": {"type": "integer", "minimum": 16, "maximum": 4320, "multipleOf": 2},
        "fps": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "lang": {
      "description": "ISO 639-1 code, for example en or vi.",
      "type": "string",
      "pattern": "^[a-z]{2}(?![\\s\\S])"
    },
    "localized": {
      "description": "Text per language code.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/lang"},
      "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "path": {
      "description": "File path relative to the folder of scenes.json.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
    },
    "scene": {
      "type": "object",
      "required": ["id", "narration", "visual"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])", "maxLength": 64},
        "chapter": {"$ref": "#/$defs/localized"},
        "narration": {"$ref": "#/$defs/localized"},
        "duration_s": {
          "description": "Minimum scene length in seconds. With audio, the scene lasts max(duration_s, audio length + tail).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 900
        },
        "audio": {
          "description": "Narration audio per language, filled by the voice step.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/lang"},
          "additionalProperties": {"$ref": "#/$defs/path"}
        },
        "visual": {
          "oneOf": [
            {"$ref": "#/$defs/visual_title"},
            {"$ref": "#/$defs/visual_image"},
            {"$ref": "#/$defs/visual_video"}
          ]
        }
      }
    },
    "visual_title": {
      "description": "A title card: text on a solid background.",
      "type": "object",
      "required": ["kind", "text"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "title"},
        "text": {"$ref": "#/$defs/localized"},
        "background": {"$ref": "#/$defs/color"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "visual_image": {
      "description": "A still image (PNG, JPEG or SVG), fitted to the frame, with an optional slow camera move.",
      "type": "object",
      "required": ["kind", "src"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "image"},
        "src": {"$ref": "#/$defs/path"},
        "motion": {"enum": ["none", "zoom-in", "zoom-out", "pan-left", "pan-right"]},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_video": {
      "description": "A video clip (for example a Manim, Motion Canvas or VHS render). Its own audio is dropped. A short clip holds its last frame unless loop is true.",
      "type": "object",
      "required": ["kind", "src"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "video"},
        "src": {"$ref": "#/$defs/path"},
        "start_s": {"type": "number", "minimum": 0},
        "loop": {"type": "boolean"},
        "background": {"$ref": "#/$defs/color"}
      }
    }
  }
}
