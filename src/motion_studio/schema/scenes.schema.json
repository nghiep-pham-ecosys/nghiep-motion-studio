{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nghiep-motion-studio:scenes:1",
  "title": "scenes.json",
  "description": "One video as a list of scenes. One file serves every language: narration and on-screen text are keyed by language code, visuals are shared.",
  "type": "object",
  "required": ["version", "title", "languages", "scenes"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "title": {"$ref": "#/$defs/localized"},
    "languages": {
      "description": "Languages this video is made in. Every localized field must cover each of them.",
      "type": "array",
      "items": {"$ref": "#/$defs/lang"},
      "minItems": 1,
      "uniqueItems": true
    },
    "output": {
      "description": "Output format. Defaults: 1920x1080 at 30 fps.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 16, "maximum": 7680, "multipleOf": 2},
        "height": {"type": "integer", "minimum": 16, "maximum": 4320, "multipleOf": 2},
        "fps": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    },
    "theme": {
      "description": "Colours and fonts of frames and generated visuals. Default: light.",
      "enum": ["light", "dark"]
    },
    "speakers": {
      "description": "Named voices. Each speaker gives, per language, the TTS engine and voice that read its scenes. A language it leaves out falls back to the default voice of the narrate command.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/voice_by_lang"}
    },
    "voice_mix": {
      "description": "Who reads the scenes that name no speaker. narrator: one speaker (needs narrator). alternate-chapters: the speakers take turns, a new chapter starting at every scene with chapter (needs speakers).",
      "type": "object",
      "required": ["policy"],
      "additionalProperties": false,
      "properties": {
        "policy": {"enum": ["narrator", "alternate-chapters"]},
        "narrator": {"$ref": "#/$defs/id"},
        "speakers": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "lang": {
      "description": "ISO 639-1 code, for example en or vi.",
      "type": "string",
      "pattern": "^[a-z]{2}(?![\\s\\S])"
    },
    "localized": {
      "description": "Text per language code.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/lang"},
      "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "path": {
      "description": "File path relative to the folder of scenes.json.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
    },
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])", "maxLength": 64},
    "voice_ref": {
      "description": "A TTS engine and one of its voices, for example {\"engine\": \"kokoro\", \"voice\": \"af_heart\"} or {\"engine\": \"clone-en\", \"voice\": \"clone\"}.",
      "type": "object",
      "required": ["engine", "voice"],
      "additionalProperties": false,
      "properties": {
        "engine": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])", "maxLength": 32},
        "voice": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 64}
      }
    },
    "voice_by_lang": {
      "description": "A voice per language code.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/lang"},
      "additionalProperties": {"$ref": "#/$defs/voice_ref"}
    },
    "label": {
      "description": "On-screen text: one string for every language, or text per language code.",
      "anyOf": [
        {"type": "string", "minLength": 1, "pattern": "\\S"},
        {"$ref": "#/$defs/localized"}
      ]
    },
    "scene": {
      "type": "object",
      "required": ["id", "narration", "visual"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "chapter": {"$ref": "#/$defs/localized"},
        "narration": {"$ref": "#/$defs/localized"},
        "speaker": {"description": "Who reads this scene: a key of /speakers. Overrides voice_mix.", "$ref": "#/$defs/id"},
        "voice": {"description": "This scene's own voice per language. Overrides speaker and voice_mix.", "$ref": "#/$defs/voice_by_lang"},
        "duration_s": {
          "description": "Minimum scene length in seconds. With audio, the scene lasts max(duration_s, audio length + tail).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 900
        },
        "audio": {
          "description": "Narration audio per language, filled by the voice step.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/lang"},
          "additionalProperties": {"$ref": "#/$defs/path"}
        },
        "visual": {
          "oneOf": [
            {"$ref": "#/$defs/visual_title"},
            {"$ref": "#/$defs/visual_image"},
            {"$ref": "#/$defs/visual_video"},
            {"$ref": "#/$defs/visual_manim"},
            {"$ref": "#/$defs/visual_diagram"},
            {"$ref": "#/$defs/visual_code"},
            {"$ref": "#/$defs/visual_terminal"},
            {"$ref": "#/$defs/visual_dialogue"},
            {"$ref": "#/$defs/visual_illustrated"},
            {"$ref": "#/$defs/visual_card"}
          ]
        }
      }
    },
    "visual_title": {
      "description": "A title card: text on a solid background.",
      "type": "object",
      "required": ["kind", "text"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "title"},
        "text": {"$ref": "#/$defs/localized"},
        "background": {"$ref": "#/$defs/color"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "visual_image": {
      "description": "A still image (PNG, JPEG or SVG), fitted to the frame, with an optional slow camera move.",
      "type": "object",
      "required": ["kind", "src"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "image"},
        "src": {"$ref": "#/$defs/path"},
        "motion": {"enum": ["none", "zoom-in", "zoom-out", "pan-left", "pan-right"]},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_video": {
      "description": "A video clip (for example a screen recording). Its own audio is dropped. A short clip holds its last frame unless loop is true.",
      "type": "object",
      "required": ["kind", "src"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "video"},
        "src": {"$ref": "#/$defs/path"},
        "start_s": {"type": "number", "minimum": 0},
        "loop": {"type": "boolean"},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_manim": {
      "description": "A custom Manim CE scene rendered to a clip at the output size. It runs Python from the repository, so use trusted files only. The scene lasts at least as long as the clip.",
      "type": "object",
      "required": ["kind", "src", "scene"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "manim"},
        "src": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.py(?![\\s\\S])"}]},
        "scene": {"description": "Name of the Scene class in src.", "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"},
        "loop": {"type": "boolean"},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_diagram": {
      "description": "An animated box-and-arrow diagram drawn with Manim from data. Nodes sit on a grid (col, row) and appear step by step; an edge appears with the step that shows both of its ends. The motion fits the scene length.",
      "type": "object",
      "required": ["kind", "nodes"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "diagram"},
        "title": {"$ref": "#/$defs/label"},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": ["id", "label", "col", "row"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "label": {"$ref": "#/$defs/label"},
              "col": {"type": "integer", "minimum": 0, "maximum": 7},
              "row": {"type": "integer", "minimum": 0, "maximum": 5},
              "color": {"$ref": "#/$defs/color"}
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 48,
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": {"$ref": "#/$defs/id"},
              "to": {"$ref": "#/$defs/id"},
              "label": {"$ref": "#/$defs/label"}
            }
          }
        },
        "steps": {
          "description": "Node ids revealed together, in order. Default: one node per step in list order. Every node is in exactly one step.",
          "type": "array",
          "minItems": 1,
          "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
        },
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_code": {
      "description": "An animated code block drawn with Manim: the code is written line by line, then each highlight range is framed while the other lines dim. The motion fits the scene length.",
      "type": "object",
      "required": ["kind", "src"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "code"},
        "src": {"$ref": "#/$defs/path"},
        "language": {"description": "Pygments lexer name. Default: from the file extension.", "type": "string", "pattern": "^[a-z0-9][a-z0-9+#._-]*(?![\\s\\S])"},
        "style": {"description": "Pygments style name. Default: the code colours of the theme.", "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(?![\\s\\S])"},
        "title": {"$ref": "#/$defs/label"},
        "highlight": {
          "description": "Line ranges [first, last], 1-based and inclusive, framed in order.",
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "array",
            "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_dialogue": {
      "description": "Two original characters on a background, drawn from SVG files; the one named by talk speaks the scene's narration: its mouth follows the loudness of the scene's audio, it sways and glows, the other blinks and nods. Optional part label, caption, board and a pause after the narration (scale x its length + add_s seconds, with a cue and a countdown bar). The clip lasts narration + 0.5 s + pause, so the scene is stretched to it.",
      "type": "object",
      "required": ["kind", "scenery", "cast", "talk"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "dialogue"},
        "scenery": {"description": "Background SVG (1920 x 1080 canvas).", "allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.svg(?![\\s\\S])"}]},
        "cast": {
          "description": "The character SVG of each side (440 x 700 canvas with the groups glow, head, eyes-open, eyes-closed, mouth-0, mouth-1, mouth-2).",
          "type": "object",
          "required": ["her", "him"],
          "additionalProperties": false,
          "properties": {
            "her": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.svg(?![\\s\\S])"}]},
            "him": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.svg(?![\\s\\S])"}]}
          }
        },
        "talk": {"description": "Who speaks this scene's narration.", "enum": ["her", "him"]},
        "part": {"description": "Label at the top left, e.g. 2 · Words.", "type": "string", "maxLength": 60},
        "label": {"description": "Label at the top right, e.g. AI voice.", "type": "string", "maxLength": 40},
        "caption": {
          "description": "The current sentence in the caption box; **x** marks a word in the accent colour; sub is a second line (e.g. the Vietnamese meaning).",
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 600},
            "sub": {"type": "string", "minLength": 1, "maxLength": 600}
          }
        },
        "board": {
          "description": "A panel above the caption: a title and lines of text in a style (big, vi, body, dim, bullet, small).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {"type": "string", "maxLength": 80},
            "lines": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": ["text"],
                "additionalProperties": false,
                "properties": {
                  "text": {"type": "string", "minLength": 1, "maxLength": 1200},
                  "style": {"enum": ["big", "vi", "body", "dim", "bullet", "small"]}
                }
              }
            }
          }
        },
        "pause": {
          "description": "Silence after the narration: scale x the narration length + add_s seconds; cue (e.g. Your turn) shows with a countdown bar.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scale": {"type": "number", "minimum": 0, "maximum": 4},
            "add_s": {"type": "number", "minimum": 0, "maximum": 120},
            "cue": {"type": "string", "minLength": 1, "maxLength": 30}
          }
        },
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_illustrated": {
      "description": "A still of the illustrated lesson library (JPEG or PNG) with a slow push-in towards focus (the speaker), a large speech bubble on the side of the one named by talk (the caption, with its second line), labels, a board card on the other side and a pause after the narration (scale x its length + add_s seconds, with a cue and a countdown bar). The clip lasts narration + 0.5 s + pause, so the scene is stretched to it.",
      "type": "object",
      "required": ["kind", "image", "talk"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "illustrated"},
        "image": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.(jpe?g|png)(?![\\s\\S])"}]},
        "focus": {
          "description": "Where the camera moves to, as a share of the width and height (the speaker's face).",
          "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "talk": {"description": "Who speaks this scene's narration: the bubble sits on that side.", "enum": ["her", "him"]},
        "name": {"description": "The speaker's name on the bubble.", "type": "string", "maxLength": 30},
        "part": {"description": "Label at the top left, e.g. 2 · Words.", "type": "string", "maxLength": 60},
        "label": {"description": "Label at the top right, e.g. AI voice.", "type": "string", "maxLength": 40},
        "badge": {"description": "Second label at the top right, e.g. Made with AI.", "type": "string", "maxLength": 40},
        "caption": {"$ref": "#/$defs/visual_dialogue/properties/caption"},
        "board": {"$ref": "#/$defs/visual_dialogue/properties/board"},
        "pause": {"$ref": "#/$defs/visual_dialogue/properties/pause"},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_card": {
      "description": "A full-frame panel (code, program output, a bar chart, points, a flow of boxes or a picture) with the speaker's still as a square inset cropped around focus, the speaker's name, the panel's source note, the caption across the bottom and the part and AI labels. Code and output lines are part of the visual. The clip lasts narration + 0.5 s, so the scene is stretched to it.",
      "type": "object",
      "required": ["kind", "image", "talk", "panel"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "card"},
        "image": {"$ref": "#/$defs/visual_illustrated/properties/image"},
        "focus": {"$ref": "#/$defs/visual_illustrated/properties/focus"},
        "talk": {"$ref": "#/$defs/visual_illustrated/properties/talk"},
        "name": {"$ref": "#/$defs/visual_illustrated/properties/name"},
        "part": {"$ref": "#/$defs/visual_illustrated/properties/part"},
        "label": {"$ref": "#/$defs/visual_illustrated/properties/label"},
        "badge": {"$ref": "#/$defs/visual_illustrated/properties/badge"},
        "caption": {"$ref": "#/$defs/visual_dialogue/properties/caption"},
        "panel": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["code", "output", "chart", "points", "flow", "image"]},
            "title": {"type": "string", "maxLength": 90},
            "source": {"description": "Where the content comes from, shown under the speaker's name.", "type": "string", "maxLength": 120},
            "lines": {"description": "code and output: the lines shown.", "type": "array", "maxItems": 40, "items": {"type": "string", "maxLength": 400}},
            "first_line": {"type": "integer", "minimum": 1},
            "highlight": {"type": "array", "maxItems": 8, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}},
            "bars": {
              "description": "chart: one horizontal bar per item.",
              "type": "array", "minItems": 1, "maxItems": 6,
              "items": {
                "type": "object", "required": ["label", "value"], "additionalProperties": false,
                "properties": {
                  "label": {"type": "string", "minLength": 1, "maxLength": 60},
                  "value": {"type": "number", "minimum": 0},
                  "text": {"type": "string", "maxLength": 40}
                }
              }
            },
            "max": {"description": "chart: the value a full bar stands for (drawn as a dashed line).", "type": "number", "exclusiveMinimum": 0},
            "note": {"type": "string", "maxLength": 120},
            "items": {"description": "points: the bullet items (**bold** allowed).", "type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
            "columns": {"description": "flow: columns of boxes, left to right; every box points at every box of the next column.", "type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 60}}},
            "src": {"description": "image: the picture fitted into the panel.", "allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.(jpe?g|png)(?![\\s\\S])"}]}
          }
        },
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_terminal": {
      "description": "A terminal recording made by VHS from a .tape file. The tape runs real shell commands, so use trusted files only. It must not set Output, Width, Height or Framerate. The scene lasts at least as long as the recording.",
      "type": "object",
      "required": ["kind", "src"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "terminal"},
        "src": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.tape(?![\\s\\S])"}]},
        "loop": {"type": "boolean"},
        "background": {"$ref": "#/$defs/color"}
      }
    }
  }
}
