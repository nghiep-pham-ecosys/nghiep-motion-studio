{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nghiep-motion-studio:scenes:1",
  "title": "scenes.json",
  "description": "One video as a list of scenes. One file serves every language: narration and on-screen text are keyed by language code, visuals are shared.",
  "type": "object",
  "required": ["version", "title", "languages", "scenes"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "title": {"$ref": "#/$defs/localized"},
    "languages": {
      "description": "Languages this video is made in. Every localized field must cover each of them.",
      "type": "array",
      "items": {"$ref": "#/$defs/lang"},
      "minItems": 1,
      "uniqueItems": true
    },
    "output": {
      "description": "Output format. Defaults: 1920x1080 at 30 fps.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 16, "maximum": 7680, "multipleOf": 2},
        "height": {"type": "integer", "minimum": 16, "maximum": 4320, "multipleOf": 2},
        "fps": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    },
    "theme": {
      "description": "Colours and fonts of frames and generated visuals. Default: light.",
      "enum": ["light", "dark"]
    },
    "speakers": {
      "description": "Named voices. Each speaker gives, per language, the TTS engine and voice that read its scenes. A language it leaves out falls back to the default voice of the narrate command.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/voice_by_lang"}
    },
    "voice_mix": {
      "description": "Who reads the scenes that name no speaker. narrator: one speaker (needs narrator). alternate-chapters: the speakers take turns, a new chapter starting at every scene with chapter (needs speakers).",
      "type": "object",
      "required": ["policy"],
      "additionalProperties": false,
      "properties": {
        "policy": {"enum": ["narrator", "alternate-chapters"]},
        "narrator": {"$ref": "#/$defs/id"},
        "speakers": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "lang": {
      "description": "ISO 639-1 code, for example en or vi.",
      "type": "string",
      "pattern": "^[a-z]{2}(?![\\s\\S])"
    },
    "localized": {
      "description": "Text per language code.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/lang"},
      "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "path": {
      "description": "File path relative to the folder of scenes.json.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
    },
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])", "maxLength": 64},
    "voice_ref": {
      "description": "A TTS engine and one of its voices, for example {\"engine\": \"kokoro\", \"voice\": \"af_heart\"} or {\"engine\": \"clone-en\", \"voice\": \"clone\"}.",
      "type": "object",
      "required": ["engine", "voice"],
      "additionalProperties": false,
      "properties": {
        "engine": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])", "maxLength": 32},
        "voice": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 64}
      }
    },
    "voice_by_lang": {
      "description": "A voice per language code.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/lang"},
      "additionalProperties": {"$ref": "#/$defs/voice_ref"}
    },
    "label": {
      "description": "On-screen text: one string for every language, or text per language code.",
      "anyOf": [
        {"type": "string", "minLength": 1, "pattern": "\\S"},
        {"$ref": "#/$defs/localized"}
      ]
    },
    "scene": {
      "type": "object",
      "required": ["id", "narration", "visual"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "chapter": {"$ref": "#/$defs/localized"},
        "narration": {"$ref": "#/$defs/localized"},
        "speaker": {"description": "Who reads this scene: a key of /speakers. Overrides voice_mix.", "$ref": "#/$defs/id"},
        "voice": {"description": "This scene's own voice per language. Overrides speaker and voice_mix.", "$ref": "#/$defs/voice_by_lang"},
        "duration_s": {
          "description": "Minimum scene length in seconds. With audio, the scene lasts max(duration_s, audio length + tail).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 900
        },
        "audio": {
          "description": "Narration audio per language, filled by the voice step.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/lang"},
          "additionalProperties": {"$ref": "#/$defs/path"}
        },
        "visual": {
          "oneOf": [
            {"$ref": "#/$defs/visual_title"},
            {"$ref": "#/$defs/visual_image"},
            {"$ref": "#/$defs/visual_video"},
            {"$ref": "#/$defs/visual_manim"},
            {"$ref": "#/$defs/visual_diagram"},
            {"$ref": "#/$defs/visual_code"},
            {"$ref": "#/$defs/visual_terminal"}
          ]
        }
      }
    },
    "visual_title": {
      "description": "A title card: text on a solid background.",
      "type": "object",
      "required": ["kind", "text"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "title"},
        "text": {"$ref": "#/$defs/localized"},
        "background": {"$ref": "#/$defs/color"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "visual_image": {
      "description": "A still image (PNG, JPEG or SVG), fitted to the frame, with an optional slow camera move.",
      "type": "object",
      "required": ["kind", "src"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "image"},
        "src": {"$ref": "#/$defs/path"},
        "motion": {"enum": ["none", "zoom-in", "zoom-out", "pan-left", "pan-right"]},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_video": {
      "description": "A video clip (for example a screen recording). Its own audio is dropped. A short clip holds its last frame unless loop is true.",
      "type": "object",
      "required": ["kind", "src"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "video"},
        "src": {"$ref": "#/$defs/path"},
        "start_s": {"type": "number", "minimum": 0},
        "loop": {"type": "boolean"},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_manim": {
      "description": "A custom Manim CE scene rendered to a clip at the output size. It runs Python from the repository, so use trusted files only. The scene lasts at least as long as the clip.",
      "type": "object",
      "required": ["kind", "src", "scene"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "manim"},
        "src": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.py(?![\\s\\S])"}]},
        "scene": {"description": "Name of the Scene class in src.", "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"},
        "loop": {"type": "boolean"},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_diagram": {
      "description": "An animated box-and-arrow diagram drawn with Manim from data. Nodes sit on a grid (col, row) and appear step by step; an edge appears with the step that shows both of its ends. The motion fits the scene length.",
      "type": "object",
      "required": ["kind", "nodes"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "diagram"},
        "title": {"$ref": "#/$defs/label"},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": ["id", "label", "col", "row"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "label": {"$ref": "#/$defs/label"},
              "col": {"type": "integer", "minimum": 0, "maximum": 7},
              "row": {"type": "integer", "minimum": 0, "maximum": 5},
              "color": {"$ref": "#/$defs/color"}
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 48,
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": {"$ref": "#/$defs/id"},
              "to": {"$ref": "#/$defs/id"},
              "label": {"$ref": "#/$defs/label"}
            }
          }
        },
        "steps": {
          "description": "Node ids revealed together, in order. Default: one node per step in list order. Every node is in exactly one step.",
          "type": "array",
          "minItems": 1,
          "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
        },
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_code": {
      "description": "An animated code block drawn with Manim: the code is written line by line, then each highlight range is framed while the other lines dim. The motion fits the scene length.",
      "type": "object",
      "required": ["kind", "src"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "code"},
        "src": {"$ref": "#/$defs/path"},
        "language": {"description": "Pygments lexer name. Default: from the file extension.", "type": "string", "pattern": "^[a-z0-9][a-z0-9+#._-]*(?![\\s\\S])"},
        "style": {"description": "Pygments style name. Default: the code colours of the theme.", "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(?![\\s\\S])"},
        "title": {"$ref": "#/$defs/label"},
        "highlight": {
          "description": "Line ranges [first, last], 1-based and inclusive, framed in order.",
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "array",
            "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "visual_terminal": {
      "description": "A terminal recording made by VHS from a .tape file. The tape runs real shell commands, so use trusted files only. It must not set Output, Width, Height or Framerate. The scene lasts at least as long as the recording.",
      "type": "object",
      "required": ["kind", "src"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "terminal"},
        "src": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.tape(?![\\s\\S])"}]},
        "loop": {"type": "boolean"},
        "background": {"$ref": "#/$defs/color"}
      }
    }
  }
}
